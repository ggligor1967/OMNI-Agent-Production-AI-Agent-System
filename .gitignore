/async_test
/chain
/ckpt_test
/cond_test
/fallback_test
/filter_test
/reg_pipe
/retry_test
/skip_test
/test

# ── Databases & state ────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Build / dist ─────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/

