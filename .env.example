# OMNI Agent — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# ── Ollama Endpoint ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Default model (auto-routing uses this as fallback) ────────────────────────
OLLAMA_MODEL=qwen3-next:80b-cloud

# ── Task-specific model routing ────────────────────────────────────────────────
# Override which model handles each task type.
# Leave blank to let the auto-router decide.
MODEL_CODE=qwen3-coder-next:cloud
MODEL_MATH=deepseek-v3.1:671b-cloud
MODEL_VISION=qwen3-vl:235b-instruct-cloud
MODEL_REASON=cogito-2.1:671b-cloud
MODEL_FAST=gemma3:4b-cloud
MODEL_CREATIVE=gpt-oss:120b-cloud
MODEL_AGENT=devstral-2:123b-cloud
MODEL_MULTILANG=mistral-large-3:675b-cloud
MODEL_LONGCTX=minimax-m2.5:cloud

# ── Auto-routing toggle ────────────────────────────────────────────────────────
MODEL_AUTO_ROUTE=true

# ── Exclude specific models from routing (comma-separated) ────────────────────
# Example: exclude the smallest models from routing
# MODEL_EXCLUDE=rnj-1:8b-cloud,gemma3:4b-cloud

# ── Prefer a specific provider (optional) ─────────────────────────────────────
# MODEL_PREFER_PROVIDER=Alibaba

# ── Models used for /compare endpoint ─────────────────────────────────────────
MODEL_COMPARE_IDS=qwen3-next:80b-cloud,gpt-oss:120b-cloud,deepseek-v3.1:671b-cloud

# ─────────────────────────────────────────────────────────────────────────────
# AVAILABLE MODELS (all 27 cloud models):
# ─────────────────────────────────────────────────────────────────────────────
#
# ALIBABA (Qwen family):
#   qwen3-vl:235b-instruct-cloud  — Vision flagship, 128k, multimodal
#   qwen3-vl:235b-cloud           — Vision, 128k
#   qwen3-coder-next:cloud        — Coding flagship, 128k
#   qwen3-coder:480b-cloud        — Coding 480B, 256k context
#   qwen3-next:80b-cloud          — General flagship, 128k
#   qwen3.5:cloud                 — Balanced, 128k
#
# ZHIPU AI (GLM family):
#   glm-5:cloud                   — Flagship, 128k, bilingual
#   glm-4.7:cloud                 — Balanced, 128k, bilingual
#
# DEEPSEEK:
#   deepseek-v3.1:671b-cloud      — Reasoning/math flagship, 128k
#   deepseek-v3.2:cloud           — General/reasoning upgrade
#
# OPENAI OSS:
#   gpt-oss:120b-cloud            — General flagship, 128k
#   gpt-oss:20b-cloud             — Fast, 64k
#
# GOOGLE:
#   gemini-3-flash-preview:cloud  — 1M context, vision, fast
#   gemma3:12b-cloud              — Balanced, 128k
#   gemma3:4b-cloud               — Micro/fast, 128k
#
# MISTRAL AI:
#   mistral-large-3:675b-cloud    — Multilingual flagship, 128k
#   ministral-3:8b-cloud          — Micro, 128k
#   devstral-2:123b-cloud         — Coding/agents, 128k
#   devstral-small-2:24b-cloud    — Coding fast, 64k
#
# NVIDIA:
#   nemotron-3-nano:30b-cloud     — Balanced, 32k
#   nemotron-3-super:cloud        — Stronger balanced/reasoning tier
#
# MINIMAX:
#   minimax-m2:cloud              — 1M context, creative
#   minimax-m2.5:cloud            — 1M context, flagship
#   minimax-m2.7:cloud            — 1M context, latest flagship
#
# COGITO:
#   cogito-2.1:671b-cloud         — Reasoning/math, 128k
#
# MOONSHOT AI:
#   kimi-k2.5:cloud               — Long-context, 128k, bilingual
#
# RNJ LABS:
#   rnj-1:8b-cloud                — Micro/fast, 32k

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/omni_agent.db
DB_BACKEND=sqlite
# POSTGRES_DSN=postgresql://omni:omni@localhost:5432/omni_agent

# ── Web Search ────────────────────────────────────────────────────────────────
SEARXNG_URL=http://localhost:8080

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_32_char_string
RATE_LIMIT_PER_MINUTE=30
ENABLE_SANDBOX=true
AUTH_ENFORCE=true
# One-time bootstrap secret used only for POST /auth/bootstrap when no API keys exist yet.
# Set this before first startup if you need to provision the initial admin API key remotely.
AUTH_BOOTSTRAP_TOKEN=

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_FALLBACK_PORTS=8010

# ── Heartbeat ─────────────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL=60
HEARTBEAT_WEBHOOK=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/omni_agent.log
