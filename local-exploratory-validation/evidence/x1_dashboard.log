// ── Utils ─────────────────────────────────────────────────────────
function escHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function escAttr(s){return escHtml(s).replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

// ── Boot ──────────────────────────────────────────────────────────
bindDashboardEvents();
hydrateSavedKey();
initOverview();
setInterval(initOverview,20000);
</script>
